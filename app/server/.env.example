NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
TZ=Asia/Manila

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

JWT_ACCESS_SECRET=changeme_access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme_refresh
JWT_REFRESH_EXPIRES_IN=7d

SUPERADMIN_SCRIPT_SECRET=changeme_superadmin_script

REDIS_URL=redis://default:<password>@<host>:<port>
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=changeme_aws_access_key
AWS_SECRET_ACCESS_KEY=changeme_aws_secret_key
S3_PRODUCT_TRANSFER_BUCKET=changeme-product-transfers
PRODUCT_TRANSFER_WORKER_CONCURRENCY=1
