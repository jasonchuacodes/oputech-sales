{
  "name": "oputech-sales",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @oputech/sales-client --filter @oputech/sales-server dev",
    "dev:client": "pnpm --filter @oputech/sales-client dev",
    "dev:server": "pnpm --filter @oputech/sales-server dev",
    "build": "pnpm --filter @oputech/sales-client build && pnpm --filter @oputech/sales-server build",
    "lint": "pnpm --filter @oputech/sales-client lint && pnpm --filter @oputech/sales-server typecheck",
    "test": "pnpm --recursive test"
  },
  "dependencies": {
    "lucide-react": "^1.17.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "bcrypt"
    ]
  },
  "devDependencies": {
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0"
  }
}
