{
  "name": "oputech-sales",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "pnpm --filter @oputech/sales-client dev",
    "dev:server": "pnpm --filter @oputech/sales-server dev",
    "clear-database": "pnpm --filter @oputech/sales-server clear-database",
    "register-superadmin": "pnpm --filter @oputech/sales-server register-superadmin",
    "build": "pnpm --filter @oputech/sales-client build && pnpm --filter @oputech/sales-server build",
    "lint": "pnpm --filter @oputech/sales-client lint && pnpm --filter @oputech/sales-server typecheck",
    "test": "pnpm --recursive test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "bcrypt"
    ]
  },
  "devDependencies": {
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0"
  }
}
